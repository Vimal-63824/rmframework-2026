<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="POM Road Map TestSuite">
	<listeners>
		<listener class-name="utils.RetryListener"></listener>
		<listener class-name="utils.Listener"></listener>
	</listeners>
	<test parallel="classes" name="POM Road Map Test" thread-count="3">
		<classes>
			<class name="com.roadmapERP.PurchaseOrderTest" />
			<class name="com.roadmapERP.PurchaseRequestTest" />
			<class name="com.roadmapERP.POAmendmentTest" />
			<class name="com.roadmapERP.PriselistTest" />
			<class name="com.roadmapERP.GrnTest" />
			<class name="com.roadmapERP.RfqTest" />
		</classes>
	</test>
</suite>